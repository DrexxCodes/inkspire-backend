{
  "name": "inkspire-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inkspire Fastify backend. The only service that talks to Firestore, PostgreSQL and object storage.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:prod": "tsx watch --env-file=.env.prod src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "start:prod": "node --env-file=.env.prod dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "tsx --env-file=.env scripts/apply-sql.ts",
    "db:migrate:prod": "tsx --env-file=.env.prod scripts/apply-sql.ts",
    "migrate:works": "tsx --env-file=.env scripts/migrate-works-to-postgres.ts",
    "migrate:works:prod": "tsx --env-file=.env.prod scripts/migrate-works-to-postgres.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:prod": "tsx --env-file=.env.prod scripts/seed.ts",
    "make-admin": "tsx --env-file=.env scripts/make-admin.ts",
    "make-admin:prod": "tsx --env-file=.env.prod scripts/make-admin.ts",
    "check:firestore": "tsx --env-file=.env scripts/check-firestore.ts",
    "check:firestore:prod": "tsx --env-file=.env.prod scripts/check-firestore.ts",
    "deploy:firestore": "tsx scripts/deploy-firestore.ts dev",
    "deploy:firestore:prod": "tsx scripts/deploy-firestore.ts prod"
  },
  "dependencies": {
    "@dicebear/collection": "^9.2.0",
    "@dicebear/core": "^9.2.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "fastify": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "pg": "^8.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
