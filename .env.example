# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Firebase Admin (server only, never expose to the frontend)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n escapes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Public web API key, used server side only to ask Firebase to send password reset emails
FIREBASE_WEB_API_KEY=

# Supabase PostgreSQL (analytics, audit logs). Use the pooled connection string.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
DATABASE_SSL=true

# Supabase Storage (service role key stays on the server)
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=inkspire

# Platform settings cache lifetime in milliseconds
SETTINGS_CACHE_TTL_MS=60000

# Emails (comma separated) that become super_admin at registration if the email is verified
SUPER_ADMIN_EMAILS=
